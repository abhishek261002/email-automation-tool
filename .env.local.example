# ==============================================================
# Environment Variables — Cold Email & Referral Outreach Platform
# ==============================================================
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to version control.
# All secrets are server-side only (never exposed to the client).
# Requirement 11.1
# ==============================================================

# ----------------------------------
# Supabase
# ----------------------------------
# Your Supabase project URL (e.g. https://xyzxyzxyz.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key — safe for client-side use
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key — SERVER-SIDE ONLY, bypasses RLS
# Used by the cron dispatch endpoint and server API routes
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ----------------------------------
# Google Gemini AI
# ----------------------------------
# Gemini 1.5 Flash API key — SERVER-SIDE ONLY
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ----------------------------------
# Gmail API (OAuth2)
# ----------------------------------
# OAuth2 credentials from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GMAIL_CLIENT_ID=your_gmail_oauth2_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_oauth2_client_secret_here

# OAuth2 refresh token — obtain via OAuth2 playground or your own OAuth flow
# https://developers.google.com/oauthplayground/
GMAIL_REFRESH_TOKEN=your_gmail_oauth2_refresh_token_here

# Gmail address used as the sender
GMAIL_SENDER_ADDRESS=your_gmail_address@gmail.com

# ----------------------------------
# Cron Dispatch Security
# ----------------------------------
# Shared secret used to authenticate requests from Cron-Job.org
# Set this to a long random string (e.g. openssl rand -hex 32)
# Requirement 7.2, 7.3
CRON_SECRET=your_cron_secret_here

# ----------------------------------
# Application
# ----------------------------------
# Base URL of your deployed application (used for absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
